{
  "name": "1st-monster-interface",
  "version": "1.0.0",
  "description": "1st Monster Interface — The core of the Cherry Computer Stardust Augmental platform. AR/VR, neural interaction, holographic projection keyboard, and full-body gesture control.",
  "main": "src/core/monster.ts",
  "scripts": {
    "build":        "tsc --project tsconfig.json",
    "dev":          "tsc --watch --project tsconfig.json",
    "demo":         "open demo/index.html || xdg-open demo/index.html",
    "test":         "jest --config jest.config.js",
    "test:neural":  "jest tests/neural.test.ts",
    "lint":         "eslint src/**/*.ts",
    "type-check":   "tsc --noEmit",
    "ar-preview":   "node -e \"const { ARLayer } = require('./dist/ar/ar-layer'); const ar = new ARLayer(); ar.enable().then(() => console.log('AR preview active'));\"",
    "start":        "node dist/core/monster.js"
  },
  "keywords": [
    "AR", "VR", "neural-interface", "brain-computer-interface",
    "holographic-keyboard", "gesture-control", "haptic-feedback",
    "Cherry-Computer", "Stardust-Augmental", "1st-Monster",
    "augmented-reality", "virtual-reality", "mid-air-typing",
    "cognitive-computing", "immersive-interface"
  ],
  "author": "Cherry Computer Ltd.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Infinite-Networker/1st-Monster-Interface.git"
  },
  "homepage": "https://github.com/Infinite-Networker/1st-Monster-Interface#readme",
  "bugs": {
    "url": "https://github.com/Infinite-Networker/1st-Monster-Interface/issues"
  },
  "devDependencies": {
    "@types/node":     "^20.0.0",
    "@types/jest":     "^29.0.0",
    "typescript":      "^5.4.0",
    "jest":            "^29.0.0",
    "ts-jest":         "^29.0.0",
    "eslint":          "^8.0.0",
    "@typescript-eslint/parser":   "^7.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0"
  },
  "dependencies": {
    "three":           "^0.165.0",
    "tensorflow":      "^4.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm":  ">=9.0.0"
  }
}
